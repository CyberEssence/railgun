# PostgreSQL
POSTGRES_PASSWORD=
POSTGRES_DB=siem
POSTGRES_USER=postgres
POSTGRES_PORT=5432

# OpenSearch
OPENSEARCH_PASSWORD=
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601

# Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# JWT и шифрование
JWT_SECRET=
ENCRYPTION_KEY=

# API Settings
PORT=8080
GIN_MODE=release
LOG_LEVEL=info

# Database URL
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# ElasticSearch URL
ELASTICSEARCH_URL=http://elasticsearch:9200
OPENSEARCH_URL=http://elasticsearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INSECURE=true
ELASTIC_URL=http://elasticsearch:9200

# Redis URL
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:${REDIS_PORT}/0

# Kafka (опционально)
KAFKA_ENABLED=false
KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC=siem-logs

# Detection Settings
DETECTION_BF_THRESHOLD=5
DETECTION_BF_WINDOW_SEC=30

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SEC=60

# Grafana
GRAFANA_ADMIN=admin
GRAFANA_PASSWORD=

# SIEM Token для агентов
SIEM_TOKEN=$(openssl rand -hex 32)

# VirusTotal Api Key
VIRUSTOTAL_API_KEY=